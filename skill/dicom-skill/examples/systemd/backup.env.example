# Copy to /etc/dicom-skill/backup.env (mode 0600, owned by the service user).
# Placeholder values only; never commit the real file.

# rclone destination. Use a remote approved for clinical data at your site.
DICOM_BACKUP_REMOTE_ROOT=myremote:dicom-backup

# Node keys from dicom_nodes.local.yaml.
DICOM_BACKUP_DAILY_NODE=primary
DICOM_BACKUP_BACKFILL_NODE=secondary

# Closed, inclusive StudyDate range for the historical backfill.
DICOM_BACKUP_BACKFILL_START=20200101
DICOM_BACKUP_BACKFILL_END=20241231
